# Copy this file to  .env  (same folder) and fill in the values.
# .env is never committed to GitHub.

# From https://developer.adzuna.com/  (free, instant)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional, Phase 1 nice-to-have: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ---- Email the CSVs after each run (optional) ----
# Leave REPORT_TO blank to just keep the files in the output folder.
# See EMAIL_SETUP.md for how to get a Gmail / Google Workspace App Password.
REPORT_TO=aisha@lumorarecruitment.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
