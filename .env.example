# ------------------------------------------------------------------
# Copy this file, name the copy exactly  .env  (no .txt on the end),
# then fill in your keys below.
# ------------------------------------------------------------------

# Login for the leads board, the CV list and CV downloads.
# The public application form does NOT need this.
# Pick your own username and a strong password.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Free job-search API. Sign up at https://developer.adzuna.com/ (about 5 minutes).
# Leave these blank to stay in "sample data" mode.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Country to search: gb = United Kingdom
ADZUNA_COUNTRY=gb

# How far back counts as "just posted" (in days)
MAX_DAYS_OLD=2

# How often the tool checks for new jobs, in minutes (only used in live mode)
POLL_MINUTES=15

# Web address port. Change only if 3000 is already in use.
PORT=3000
